DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Optional Gemini Coach. Requires explicit consent in Coach UI; server-side only.
# AI_API_URL is the API base URL, not a chat-completions endpoint.
AI_COACH_LIVE_ENABLED="false"
AI_API_KEY=""
AI_API_URL="https://generativelanguage.googleapis.com/v1beta"
AI_API_MODEL=""

# Optional meal photo analysis, independent of Coach. Both are required.
# Server only. Select an image-capable Gemini generateContent model available to your account.
PHOTO_AI_API_KEY=""
PHOTO_AI_MODEL=""
