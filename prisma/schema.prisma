generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  password         String?  // Salted scrypt hash; legacy beta values migrated on login
  preferences      String?  // JSON: practical schedule, equipment, allergies, measurements
  mode             String   @default("simple")
  
  currentWeight    Float?
  targetWeight     Float?
  timeframeWeeks   Int?
  height           Float?
  waist            Float?
  
  activityLevel    String?
  stepGoal         Int      @default(8000)
  trainingLocation String   @default("both") // home | gym | both
  trainingLevel    String   @default("beginner") // beginner | intermediate | advanced

  dietRestrictions String? // JSON
  dislikedFoods    String? // JSON
  lifestyle        String? // JSON
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  dailyLogs        DailyLog[]
  mealPlans        MealPlan[]
  workouts         WorkoutLog[]
  weeklyPlans      WeeklyPlan[]
  adaptiveDecisions AdaptiveDecision[]
  coachExchanges CoachExchange[]
  ownMeals OwnMeal[]
  nutritionDecisions NutritionDecision[]
}

model NutritionDecision {
  id String @id @default(uuid())
  userId String
  proposalKey String
  status String
  summary String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, proposalKey])
}

// Manual values are approximate; unknown nutrients remain null in nutrition JSON.
model OwnMeal {
  id String @id @default(uuid())
  userId String
  name String
  components String
  portion String
  mealType String
  eatenAt DateTime
  nutrition String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, eatenAt])
}

model DailyLog {
  id          String   @id @default(uuid())
  userId      String
  date        DateTime
  
  steps       Int      @default(0)
  stepsRecorded Boolean @default(false)
  weight      Float?
  waist       Float?
  measurements String?
  
  mealsEaten  String?  // JSON
  workouts    String?  // JSON
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, date])
}

// 7-Day Plan mapping
model WeeklyPlan {
  id          String   @id @default(uuid())
  userId      String
  startDate   DateTime
  endDate     DateTime
  
  planDays    PlanDay[]
  shoppingChecks ShoppingCheck[]
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Ownership is inherited from the weekly plan; exact rows include their quantity.
model ShoppingCheck {
  weeklyPlanId String
  item String
  weeklyPlan WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  @@id([weeklyPlanId, item])
}

// One atomic question/reply pair. No profile snapshots or provider credentials.
model CoachExchange {
  id Int @id @default(autoincrement())
  userId String
  question String
  reply String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, id])
}

model AdaptiveDecision {
  id String @id @default(uuid())
  userId String
  targetStart DateTime
  status String // accepted | declined
  summary String // JSON with reasons, changes, unchanged fields
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, targetStart])
}

model PlanDay {
  id           String   @id @default(uuid())
  weeklyPlanId String
  dayOfWeek    Int      // 0-6 (Sun-Sat)
  date         DateTime
  
  meals        String   // JSON of Recipe IDs or names planned
  workoutId    String?  // References a Workout id
  activity     String?  // Notes on activity
  
  weeklyPlan   WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
}

// Legacy for backward compatibility with earlier build if needed, though replaced by WeeklyPlan/PlanDay mostly
model MealPlan {
  id          String   @id @default(uuid())
  userId      String
  startDate   DateTime
  endDate     DateTime
  planData    String   // JSON
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Reusable library of recipes
model Recipe {
  id           String   @id @default(uuid())
  title        String
  description  String
  prepTime     Int
  ingredients  String   // JSON
  instructions String   // JSON
  nutrition    String   // JSON { calories, protein, carbs, fat }
  tags         String   // JSON
}

// Reusable library of workouts
model Workout {
  id          String   @id @default(uuid())
  title       String
  type        String   // "home" or "gym"
  level       String   // "beginner", "intermediate", "advanced"
  duration    Int      // minutes
  exercises   String   // JSON [{ name, sets, reps, durationMin? }]
  logs        WorkoutLog[]
}

// Log of completed workouts
model WorkoutLog {
  id          String   @id @default(uuid())
  userId      String
  workoutId   String
  date        DateTime
  completed   Boolean  @default(false)
  notes       String?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout     Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
}
